{
  "name": "yavn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "check:public": "node scripts/check-public-allowlist.mjs",
    "predev": "node scripts/generate-game-list-manifest.mjs && node scripts/check-public-allowlist.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-game-list-manifest.mjs && node scripts/check-public-allowlist.mjs",
    "build": "tsc -b && vite build && node scripts/generate-game-seo-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "easy-cl2d": "0.3.1",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
