{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "true",
  "outputDirectory": "vercel-proxy",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "*": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "https://yavn.movvcorp.duckdns.org/"
    },
    {
      "source": "/:path*",
      "destination": "https://yavn.movvcorp.duckdns.org/:path*"
    }
  ]
}
