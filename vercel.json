{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/en/create/",
      "destination": "/en/create/index.html"
    },
    {
      "source": "/create/",
      "destination": "/create/index.html"
    },
    {
      "source": "/en/",
      "destination": "/en/index.html"
    },
    {
      "source": "/game-list/:gameId([^/.]+)",
      "destination": "/game-list/:gameId/index.html"
    },
    {
      "source": "/game-list/:gameId([^/.]+)/",
      "destination": "/game-list/:gameId/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/en",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/create",
      "destination": "/create/",
      "permanent": true
    },
    {
      "source": "/en/create",
      "destination": "/en/create/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/game-list/:gameId/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
