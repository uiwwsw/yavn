{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "*": false,
      "main": true
    }
  },
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/en/create/",
      "destination": "/en/create/index.html"
    },
    {
      "source": "/create/",
      "destination": "/create/index.html"
    },
    {
      "source": "/en/",
      "destination": "/en/index.html"
    },
    {
      "source": "/game-list/:gameId([^/.]+)",
      "destination": "/game-list/:gameId/index.html"
    },
    {
      "source": "/game-list/:gameId([^/.]+)/",
      "destination": "/game-list/:gameId/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/game-list/deokman",
      "destination": "/game-list/muwon/",
      "permanent": true
    },
    {
      "source": "/game-list/deokman/",
      "destination": "/game-list/muwon/",
      "permanent": true
    },
    {
      "source": "/game-list/deokman/:path*",
      "destination": "/game-list/muwon/",
      "permanent": true
    },
    {
      "source": "/game-list/deokman-v8-preview",
      "destination": "/game-list/muwon/",
      "permanent": true
    },
    {
      "source": "/game-list/deokman-v8-preview/",
      "destination": "/game-list/muwon/",
      "permanent": true
    },
    {
      "source": "/game-list/deokman-v8-preview/:path*",
      "destination": "/game-list/muwon/",
      "permanent": true
    },
    {
      "source": "/game-list/english-deokman",
      "destination": "/game-list/muwon/",
      "permanent": true
    },
    {
      "source": "/game-list/english-deokman/",
      "destination": "/game-list/muwon/",
      "permanent": true
    },
    {
      "source": "/game-list/english-deokman/:path*",
      "destination": "/game-list/muwon/",
      "permanent": true
    },
    {
      "source": "/game-list/erase-first",
      "destination": "/game-list/erase/",
      "permanent": true
    },
    {
      "source": "/game-list/erase-first/",
      "destination": "/game-list/erase/",
      "permanent": true
    },
    {
      "source": "/game-list/erase-first/:path*",
      "destination": "/game-list/erase/",
      "permanent": true
    },
    {
      "source": "/game-list/conan",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/conan/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/conan/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/conan-demo",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/conan-demo/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/conan-demo/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/conan-midnight-alibi",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/conan-midnight-alibi/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/conan-midnight-alibi/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/english-conan",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/english-conan/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/game-list/english-conan/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/create",
      "destination": "/create/",
      "permanent": true
    },
    {
      "source": "/en/create",
      "destination": "/en/create/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/game-list/:gameId/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/game-list/index.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/game-list/:gameId/offline.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
